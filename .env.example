# Server Runtime
NODE_ENV="production"
PORT="3000"

# Custom Domain URL (used for canonical tags, Open Graph URLs, sitemap.xml, and robots.txt)
APP_URL="https://bhagwatipublications.in"

# Admin Authentication (Configure your owner credentials before deployment)
ADMIN_EMAIL="owner@bhagwatipublications.in"
ADMIN_PASSWORD="ChangeThisStrongPassword!2026"
SESSION_SECRET="replace-with-a-random-64-char-hex-secret"

# Persistent Database & Secure File Storage Paths (mount a persistent disk here in production)
DATABASE_PATH="./data/bhagwati.db"
STORAGE_DIR="./storage"
