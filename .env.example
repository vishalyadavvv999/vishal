# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Admin Authentication (Configure your owner credentials before deployment)
ADMIN_EMAIL="owner@bhagwatipublications.com"
ADMIN_PASSWORD="ChangeThisStrongPassword!2026"
SESSION_SECRET="replace-with-a-random-64-char-hex-secret"

# Database & Secure Upload Storage Paths
DATABASE_PATH="./data/bhagwati.db"
STORAGE_DIR="./storage"
