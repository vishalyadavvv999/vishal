# Server Runtime
NODE_ENV="production"
PORT="3000"

# Custom Domain URL (used for canonical URLs, Open Graph metadata, sitemap.xml, and robots.txt)
APP_URL="https://bhagwatipublications.cv"

# Admin Authentication (set strong values in Railway / Render environment settings; never commit .env)
ADMIN_EMAIL="owner@bhagwatipublications.cv"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
SESSION_SECRET="REPLACE_WITH_64_CHAR_HEX_SECRET"

# Persistent Database & File Storage Paths (point these to your mounted persistent disk in production)
DATABASE_PATH="./data/bhagwati.db"
STORAGE_DIR="./storage"
